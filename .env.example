# Database (PostgreSQL via asyncpg)
DATABASE_URL=postgresql+asyncpg://classvault:classvault@localhost:5433/classvault

# Redis (Cache, ARQ queue, Rate limiting)
REDIS_URL=redis://localhost:6379/0

# Vector Store (Qdrant)
QDRANT_URL=http://localhost:6333

# Cloudflare R2 Storage (Private S3-compatible bucket)
R2_ACCOUNT_ID=placeholder_r2_account_id
R2_ACCESS_KEY_ID=placeholder_r2_access_key_id
R2_SECRET_ACCESS_KEY=placeholder_r2_secret_access_key
R2_BUCKET=classvault

# Security & Authentication
JWT_SECRET=classvault_super_secret_jwt_key_change_in_production_min_32_chars
COOKIE_SECURE=false
ALLOWED_EMAIL_DOMAIN=

# Initial Admin Seeding
ADMIN_EMAIL=admin@classvault.local
ADMIN_PASSWORD=AdminPassword123!

# Frontend Origin for CORS & Cookies
FRONTEND_ORIGIN=http://localhost:3000

# LLM Providers (Groq primary, Mistral fallback)
GROQ_API_KEY=gsk_placeholder_groq_api_key
MISTRAL_API_KEY=placeholder_mistral_api_key

# RAG & Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_HYBRID_ENABLED=true
CHAT_LIMIT_PER_HOUR=20
